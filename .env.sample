# ──────────────────────────────────────────────────────────────
# Copy to .env and adjust. Compose reads .env automatically.
# ──────────────────────────────────────────────────────────────

# ── Images ──
# ShinzoHub publishes only commit-SHA tags, from pushes to main/develop.
# This is the origin/develop tip. scripts/demo does not exist on main, so
# develop is the only branch that carries this demo.
SHINZOHUB_SHA=5ae56e84249f3f973bab7173f52bce61772cdd7a
SOURCEHUB_IMAGE=ghcr.io/sourcenetwork/sourcehub:dev
# Generator and host are a matched release pair, built minutes apart.
# NB: the upstream compose files in those repos reference tags that do not
# resolve (generator ':standard' is unpublished; the host's ':v0.6.5-ethereum-mainnet'
# is real but from July). These are the current ones.
HERMES_IMAGE=informalsystems/hermes:1.13.1
GENERATOR_IMAGE=ghcr.io/shinzonetwork/shinzo-generator-client:v0.6.5.4-ethereum-mainnet
HOST_IMAGE=ghcr.io/shinzonetwork/shinzo-host-client:v0.6.5.4-ethereum-mainnet
FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:latest

# ── Chains ──
# 91273001 is forced by the pinned SHA: app.go sets ChainID18Decimals to the
# testnet value on develop. The demo scripts upstream still say 91273002; if you
# repin to a SHA from before "Feat/change chain (#95)", set this back to 91273002.
SHINZOHUB_CHAIN_ID=91273001
SOURCEHUB_CHAIN_ID=sourcehub
BLOCK_TIME=1s

# Collection names are derived as {CHAIN_NAME}__{CHAIN_NETWORK}__Block. The host
# falls back to the schema baked into its image, which is named Ethereum__Mainnet__*,
# so the generator must publish under the same names or nothing replicates.
# The data is anvil's; only the naming says Mainnet.
CHAIN_NAME=Ethereum
CHAIN_NETWORK=Mainnet

# ── Anvil ──
ANVIL_CHAIN_ID=31337
ANVIL_BLOCK_TIME=2
# Interval in seconds between seeder transaction bursts.
SEED_INTERVAL=3

# DefraDB keyring secret for the generator and host. Must be non-empty: the
# generator refuses to start without it. Keep it stable across restarts if
# you want to reuse an existing .defra store.
DEFRADB_KEYRING_SECRET=local-demo-keyring-secret

# ── Resources ──
# Upstream compose reserves 13g/15g for these. Local demo values.
GENERATOR_MEM_LIMIT=4g
HOST_MEM_LIMIT=4g

# ── Ethereum source ──
# Defaults point at the bundled anvil. To index a real chain instead, set these
# to your provider and stop the anvil/seeder services.
GETH_RPC_URL=http://anvil:8545
GETH_WS_URL=ws://anvil:8545

# ── SourceHub ──
# Path of the sourcehub home directory *inside* its container. The image runs as
# user "node" with /home/node/.sourcehub symlinked here. The fund-hermes
# one-shot mounts the same volume to reach the faucet key. If the image changes
# its home or its user, this is the knob to turn.
SOURCEHUB_HOME=/sourcehub
